{
  "name": "@andrglo/react-window-grid",
  "version": "0.4.2",
  "description": "A react grid with synced column and row headers",
  "repository": "https://github.com/andrglo/react-window-grid.git",
  "main": "src",
  "scripts": {
    "build": "rollup -c",
    "build:dev": "rollup -c -w",
    "start": "webpack serve",
    "test": "jest --bail --coverage --no-cache --testPathIgnorePatterns .history",
    "test:report:coverage": "cat ./coverage/lcov.info | coveralls"
  },
  "keywords": [
    "react",
    "react-window",
    "virtual",
    "window",
    "windowed",
    "table",
    "grid",
    "spreadsheet"
  ],
  "author": "Andre Gloria <andredagloria@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^10.4.0",
    "@mui/material": "^9.0.1",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@use-it/event-listener": "^0.1.7",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "coveralls": "^3.1.1",
    "css-loader": "^7.1.4",
    "dom-helpers": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.4.1",
    "lodash.startcase": "^4.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-draggable": "^4.5.0",
    "react-window": "1.8.11",
    "rollup": "^4.60.4",
    "style-loader": "^4.0.0",
    "webpack": "^5.107.1",
    "webpack-cli": "7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "files": [
    "dist",
    "src/*.js"
  ],
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "1.8.11"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "engines": {
    "node": ">20.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "jest-canvas-mock"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
